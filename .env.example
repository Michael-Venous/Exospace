# Copy to .env and fill in. Never commit .env.
# Language model: z.ai GLM is used whenever ZAI_API_KEY is set, otherwise Gemini.
ZAI_API_KEY=
ZAI_MODEL=glm-4.6v-flashx
ZAI_PLANNER_MODEL=glm-4.6v
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
GEMINI_API_KEY=
TYPESAFE_API_KEY=
# Voice layer and voice demo speech-to-text.
DEEPGRAM_API_KEY=
# race (Jev triage races the Jev + Flash planner), jev-flash (that planner alone), direct (one model
# call per step) or legacy-dual. Empty: direct when ZAI_API_KEY is set, otherwise race.
EXECUTOR=
# The target's OS (windows, macos, linux, chromeos, android or ios); firmware screens are still
# detected. Empty: guessed from the screen, which fails when one app fills it. --os overrides both.
TARGET_OS=
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_S=20
# Provisional gates; tune against held-out screenshots before deployment.
JEV_MIN_PRESENCE=0.85
JEV_MIN_CONFIDENCE=0.6

# Single language model for plans, content and recovery; Jev handles execution decisions.
FAST_MODEL=gemini-3.8-flash
GEMINI_THINKING=low
# Seconds per model call. Empty: 12 with ZAI_API_KEY (retries a hung call sooner), otherwise 30.
MODEL_TIMEOUT_S=

# Only used with EXECUTOR=legacy-dual; inactive for jev-flash.
PLANNER_MODEL=gemini-3.8-flash
PLANNER_THINKING=medium
PLANNER_TIMEOUT_S=120

# Pi hardware (header UART; ttyAMA10 is the debug port).
PICO_SERIAL=/dev/ttyAMA0
PICO_BAUD=115200
CAPTURE_DEVICE=/dev/video0
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080
BUTTON_GPIO=17

SESSION_PATH=session.json
BENCH_CSV=bench/results.csv
MODEL_LOG=bench/model_calls.jsonl
# Local backend only: the Pico's serial port for keys (brain/voice/pico firmware); clicks stay pyautogui.
LOCAL_KEYBOARD=
