# Copy to .env and fill in. Never commit .env.
# Language model: z.ai and Gemini are interchangeable. Set either key; it serves every executor.
# z.ai is used whenever ZAI_API_KEY is set, otherwise Gemini. Each has the same four settings.
ZAI_API_KEY=
ZAI_MODEL=glm-4.6v-flashx
# Empty: thinking off (GLM's reasoning costs seconds per step); any value turns it on.
ZAI_THINKING=
# Used instead of ZAI_MODEL on a 503 (high demand) or 429 (quota); empty disables.
ZAI_FALLBACK_MODEL=glm-4.6v
# The planner model (EXECUTOR=legacy-dual only).
ZAI_PLANNER_MODEL=glm-4.6v
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
GEMINI_API_KEY=
TYPESAFE_API_KEY=
# Voice layer and voice demo speech-to-text.
DEEPGRAM_API_KEY=
# race (Jev triage races the Jev + Flash planner), jev (race with no language model: Jev picks each click,
# fill, Enter or scroll and copies typed text from the request; needs just TYPESAFE_API_KEY), jev-flash (that
# planner alone), direct (one model call per step) or legacy-dual. Empty: race, with either language-model key.
EXECUTOR=
JEV_MODEL=jev-1.14.0
JEV_TIMEOUT_S=20
# Provisional gates; tune against held-out screenshots before deployment.
JEV_MIN_PRESENCE=0.85
JEV_MIN_CONFIDENCE=0.6

# Gemini's matching settings: the model for plans, content and recovery (Jev handles execution decisions).
FAST_MODEL=gemini-3.8-flash
GEMINI_THINKING=low
# Used instead of FAST_MODEL on a 503 (high demand) or 429 (quota); empty disables.
FALLBACK_MODEL=gemini-3.5-flash-lite
# Seconds per model call, either provider. Empty: 12 with ZAI_API_KEY (retries a hung call sooner), otherwise 30.
MODEL_TIMEOUT_S=

# The planner model (EXECUTOR=legacy-dual only); PLANNER_THINKING and PLANNER_TIMEOUT_S apply to both providers.
PLANNER_MODEL=gemini-3.8-flash
PLANNER_THINKING=medium
PLANNER_TIMEOUT_S=120

# Pi hardware (header UART; ttyAMA10 is the debug port).
PICO_SERIAL=/dev/ttyAMA0
PICO_BAUD=115200
CAPTURE_DEVICE=/dev/video0
CAPTURE_WIDTH=1920
CAPTURE_HEIGHT=1080
BUTTON_GPIO=17

SESSION_PATH=session.json
BENCH_CSV=bench/results.csv
MODEL_LOG=bench/model_calls.jsonl
# Local backend only: the Pico's serial port for keys (brain/voice/pico firmware); clicks stay pyautogui.
LOCAL_KEYBOARD=
# Local backend only: the monitor the agent sees and clicks (1 = the first; 0 = all of them).
LOCAL_MONITOR=0
