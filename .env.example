# Copy to .env and fill in. Never commit .env.

# Planner / baseline executor
GEMINI_API_KEY=

# B200 model server (OpenAI-compatible endpoint, e.g. vLLM)
EXECUTOR_BASE_URL=http://<b200-host>:8000/v1
EXECUTOR_MODEL=ByteDance-Seed/UI-TARS-1.5-7B

# Pi hardware
PICO_SERIAL=/dev/ttyAMA0
PICO_BAUD=115200
CAPTURE_DEVICE=/dev/video0
BUTTON_GPIO=17
